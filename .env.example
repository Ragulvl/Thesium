# ═══════════════════════════════════════════════════════════════════
# Thesium — Environment Variable Template
#
# Instructions:
#   1. Copy this file: cp .env.example .env.development
#   2. Fill in real values for your environment
#   3. NEVER commit the filled file — it is in .gitignore
#
# For production, inject all variables from a secrets manager
# (Doppler, AWS Secrets Manager, HashiCorp Vault, etc.)
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev use:
#   docker compose up postgres  (or a Neon free tier)
DATABASE_URL=postgresql://user:password@localhost:5432/thesium?sslmode=prefer

# Docker Compose database credentials (only needed for compose-based local DB)
POSTGRES_USER=thesium
POSTGRES_PASSWORD=thesium_dev_password_CHANGE_ME
POSTGRES_DB=thesium

# ── Redis ─────────────────────────────────────────────────────────
# For local dev: docker compose up redis  OR  redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Google OAuth ──────────────────────────────────────────────────
# Create at: Google Cloud Console → APIs & Services → Credentials
# Authorized JS origins: http://localhost:10000
# Authorized redirect URIs: http://localhost:10000
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── OpenRouter AI ─────────────────────────────────────────────────
# Get keys at: openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
# Optional: comma-separated list for multi-key rotation (no spaces)
# OPENROUTER_API_KEYS=sk-or-v1-KEY1,sk-or-v1-KEY2,sk-or-v1-KEY3

# ── Google Gemini AI (optional — enables multi-provider routing) ──
# Get keys at: aistudio.google.com → Get API Key
# Free tier available with generous rate limits.
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_API_KEYS=key1,key2   # Optional: multi-key rotation

# ── Groq AI (optional — enables multi-provider routing) ──────────
# Get keys at: console.groq.com → API Keys
# Free tier available with fast inference on open-source models.
# GROQ_API_KEY=your_groq_key_here
# GROQ_API_KEYS=key1,key2     # Optional: multi-key rotation

# ── AI Router Toggle ─────────────────────────────────────────────
# Set to "false" to bypass AIRouter and use legacy OpenRouter-only path.
# Safety rollback — remove after multi-provider is stable.
# USE_AI_ROUTER=true

# ── Razorpay Payments ─────────────────────────────────────────────
# Use TEST keys for development, LIVE keys for production only
# Dashboard: razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_SECRET

# ── Security ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:10000
BODY_LIMIT=1mb

# ── Pipeline Settings ─────────────────────────────────────────────
LLM_CALL_TIMEOUT_MS=30000
MAX_JOB_COST_USD=0.50
FREE_THESIS_LIMIT=2

# ── Logging ───────────────────────────────────────────────────────
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Admin Bootstrap (optional) ────────────────────────────────────
# Your personal Google subject ID. Get it by logging in and checking
# the JWT at jwt.io. This user gets SUPER_ADMIN role on first login.
# SEED_SUPER_ADMIN_GOOGLE_SUB=your_google_sub_here

# ── AI Model Overrides (optional) ─────────────────────────────────
# Override the default free models. See openrouter.ai/models for IDs.
# MODEL_FAST=nvidia/nemotron-nano-9b-v2:free
# MODEL_MEDIUM=nvidia/nemotron-3-nano-30b-a3b:free
# MODEL_LARGE=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_DRAFTER=stepfun/step-3.5-flash:free
