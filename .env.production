# ═══════════════════════════════════════════════
# Thesium — Production Environment
# ⚠️ NEVER commit this file with real values
# ═══════════════════════════════════════════════

NODE_ENV=production
PORT=3001

# ── Database ──────────────────────────────────
# Use your managed PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/thesium?sslmode=require
POSTGRES_USER=thesium
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=thesium

# ── Redis ─────────────────────────────────────
# Use managed Redis (e.g., Upstash, Redis Cloud) or Docker internal
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id

# ── AI ────────────────────────────────────────
OPENROUTER_API_KEY=your-production-openrouter-key
LLM_CALL_TIMEOUT_MS=45000
MAX_JOB_COST_USD=1.00

# ── Security ──────────────────────────────────
# Set to your actual production domain(s)
ALLOWED_ORIGINS=https://thesium.example.com,https://www.thesium.example.com
BODY_LIMIT=1mb

# ── Logging ───────────────────────────────────
LOG_LEVEL=info

# ── Admin ─────────────────────────────────────
# SEED_SUPER_ADMIN_GOOGLE_SUB=your-google-sub-id

# ── Razorpay ──────────────────────────────────
RAZORPAY_KEY_ID=your-rzp-live-key
RAZORPAY_KEY_SECRET=your-rzp-live-secret

# ── AI Models (override defaults if needed) ───
# MODEL_FAST=google/gemma-3n-2b-it
# MODEL_MEDIUM=google/gemma-3n-4b-it
# MODEL_LARGE=google/gemma-3-12b-it
# MODEL_DRAFTER=minimax/minimax-m2.5
